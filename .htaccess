# BEGIN MilesWeb-ErrorPages
ErrorDocument 503 /error_pages/503.html
# END MilesWeb-ErrorPages

# =============================================================================
# YP Nova — routing, canonical URLs and caching (generated by scripts/prerender.js)
# Canonical form: https://ypnova.com/path  (HTTPS, no "www", no trailing slash)
# =============================================================================

# Unknown URLs return a real HTTP 404 with the site's 404 page (no "soft 404s").
ErrorDocument 404 /404.html

# Never serve repository internals, even if the Git repository is deployed inside public_html.
RedirectMatch 404 (^|/)\.git(/|$)
RedirectMatch 404 (^|/)\.cpanel\.yml$
RedirectMatch 404 (^|/)seo-lastmod\.json$

AddType image/webp .webp
AddType font/woff2 .woff2
AddType application/xml .xml

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. www → non-www (one canonical host)
  RewriteCond %{HTTP_HOST} ^www\.ypnova\.com$ [NC]
  RewriteRule ^(.*)$ https://ypnova.com/$1 [R=301,L]

  # 2. HTTP → HTTPS, only when the hosting edge reports a plain-HTTP request.
  #    (Safe behind a proxy/CDN: never loops.) Also turn on "Force HTTPS Redirect"
  #    for ypnova.com in cPanel → Domains — see docs/DEPLOYMENT-SEO.md.
  RewriteCond %{HTTP:X-Forwarded-Proto} =http [NC]
  RewriteRule ^(.*)$ https://ypnova.com/$1 [R=301,L]

  # 3. /index.html → /
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^index\.html$ https://ypnova.com/ [R=301,L]

  # 4. Direct requests for pre-rendered files → their clean URL
  RewriteCond %{THE_REQUEST} \s/_pages/
  RewriteRule ^_pages/(.+)\.html$ https://ypnova.com/$1 [R=301,L]

  # 5. Remove trailing slashes (except real folders)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ https://ypnova.com/$1 [R=301,L]

  # 6. Clean URLs → pre-rendered HTML (one rule per public page)
RewriteRule ^about$ /_pages/about.html [L]
RewriteRule ^agentic-ai-development$ /_pages/agentic-ai-development.html [L]
RewriteRule ^business-process-automation$ /_pages/business-process-automation.html [L]
