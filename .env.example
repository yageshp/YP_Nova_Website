# Copy to .env (never commit real values) and rebuild after changing.

# Base URL of the backend that serves POST /api/contact (no trailing slash).
# Leave empty if no backend is deployed: the contact form then falls back to
# opening the visitor's email app instead of pretending to submit.
REACT_APP_BACKEND_URL=

# The production domain (https://ypnova.com) is set in src/config/seo.js.

# Optional Google Analytics 4 Measurement ID (or set ga4MeasurementId in public/site-config.js — no rebuild needed).
REACT_APP_GA4_ID=

# Do not ship source maps of the production bundle.
GENERATE_SOURCEMAP=false
